# Optional. With a key, Google Gemini picks the food. Without one, BiteCast uses its built-in weather rules.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Optional. Set to 1 to use sample weather and made-up places everywhere (no network needed).
DEMO_MODE=
